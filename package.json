{
  "name": "ticket-sp",
  "description": "Concert ticket automation and event catalog extension",
  "version": "0.5.1",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wxt --level info",
    "build": "wxt build --level info",
    "zip": "wxt zip --level info",
    "release": "npm run zip && node scripts/verify-output.mjs && node scripts/package-share.mjs",
    "share": "npm run release",
    "postinstall": "wxt prepare --level info",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke:live": "node scripts/smoke-live.mjs",
    "smoke:catalog": "node scripts/smoke-catalog.mjs",
    "store:assets": "node scripts/prepare-store.mjs",
    "bench:camp": "playwright test --config playwright.bench.config.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@aklinker1/zero-zip": "1.0.1",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "1.2.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.4",
    "vitest": "4.1.12",
    "wxt": "0.21.4"
  }
}
